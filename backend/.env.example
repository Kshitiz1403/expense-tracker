# Server
PORT=8080
GIN_MODE=debug

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=expense_tracker
DB_PASSWORD=your_password
DB_NAME=expense_tracker_db

# Redis (for asynq)
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# SMS Gateway
SMS_GATEWAY_SECRET=your_webhook_secret_here
SMS_GATEWAY_WEBHOOK_ID=pixel9

# LLM Provider Configuration
# Supported providers: openai, anthropic
LLM_PROVIDER=openai
LLM_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o-mini
# For Anthropic: claude-3-5-sonnet-20241022
# For OpenAI: gpt-4o-mini, gpt-4o, gpt-3.5-turbo

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:3001

# Authentication
# Generate password hash: htpasswd -bnBC 10 "" yourpassword | tr -d ':'
ADMIN_USERNAME=admin
ADMIN_PASSWORD='$2y$10$D8J4ixvs17kwFvLd3H/YZe9.dUHmL264ydXXu.ZoKR6uEJkOQMsXm'
# Generate secret: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRY_HOURS=168
